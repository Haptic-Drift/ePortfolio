{{> header}}

<div id="contents">
    <div class="box">
        <div>
            <div class="body">
                <h1>{{title}}</h1>
                <ul id="sites">
                    {{#each trips}}
                    <li>
                        <a href="/travel"><img src="/images/{{image}}" alt="{{name}}"></a>
                        <h2><a href="/travel">{{name}}</a></h2>
                        <p>{{description}}</p>
                        <p>Length: {{length}}</p>
                        <p>Starting: {{start}}</p>
                        <p>Resort: {{resort}}</p>
                        <p>Per Person: ${{perPerson}}</p>
                    </li>
                    {{/each}}
                </ul>
            </div>
        </div>
    </div>
</div>

{{> footer}}